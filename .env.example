# Copy this file to .env and replace every placeholder before deploying.
# Never commit or share the real .env file.

DB_PASSWORD=replace_with_a_strong_database_password

# Generate a new value with:
# python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=replace_with_a_base64_secret_of_at_least_32_bytes

# Optional. Without this, the AI endpoint returns a local, deterministic prioritisation fallback.
GEMINI_API_KEY=
